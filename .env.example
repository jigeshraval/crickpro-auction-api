APP_NAME="CrickPro Auction API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:16080

# Sentry error monitoring / tracing (set the DSN per environment).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Docker (docker-compose.yml) ────────────────────────────────────
# Host ports for the local stack. Next free 16XXX band after every other
# CrickPro service in dev-guide/ports.md (which stops at 16071).
APP_PORT=16080
FORWARD_DB_PORT=16081
FORWARD_PHPMYADMIN_PORT=16082
FORWARD_REDIS_PORT=16083

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# php artisan serve is single-worker by default and returns a bare 503 (no
# app log entry — it never reaches PHP) under concurrent requests, e.g. a
# browser's CORS preflight OPTIONS landing right before the actual POST.
# Confirmed hitting this in dev with a real browser client.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PHPUnit tests run on in-memory sqlite (see phpunit.xml). Docker /
# normal app runs use the mysql connection below pointing at the mysql service.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crickpro_auction
DB_USERNAME=crickpro
DB_PASSWORD=secret

# Per the original auction-api prompt spec: session/cache backed by Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
CACHE_PREFIX=crickpro_auction

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="auction@crickpro.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gate for the email-OTP send step (mirrors crickpro-api's services.email.send_enabled).
EMAIL_SEND_ENABLED=true

# ─── WhatsApp OTP (Meta Cloud API — same integration as crickpro-api) ──────
# Left blank by default: WhatsAppOtpService no-ops (logs the code, and in
# local/testing env echoes debugOtp in the response) until these are set.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Auth: single-session-per-client (see App\Http\Controllers\Auth\AuthController) ──
# Comma-separated X-CrickPro-Client values that get single-session enforcement.
AUTH_REVOKABLE_CLIENTS=crickpro-auction,crickpro-auction-app
# Comma-separated user IDs exempt from single-session revocation (dev/QA).
AUTH_NO_REVOKE_USER_IDS=

OPS_SIGNATURE=

OVERLAY_SIGNATURE=

DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_REGION=
DO_BUCKET=
DO_ENDPOINT=
DO_URL=https://cdn.crickpro.net

# CrickPro import + "Start Auctioning" (crickpro-api-v2 integration).
CRICKPRO_API_URL=http://host.docker.internal:16016
# Shared secret for the server-to-server provision call; must match api-v2.
CRICKPRO_PROVISION_SECRET=
